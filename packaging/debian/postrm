#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
    if command -v systemctl >/dev/null 2>&1; then
        systemctl try-restart acpid.service >/dev/null 2>&1 || true
    elif command -v service >/dev/null 2>&1; then
        service acpid restart >/dev/null 2>&1 || true
    fi
fi
exit 0
